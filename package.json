{
  "name": "dsh-niubash-windows",
  "version": "0.3.1",
  "description": "Niubash (native Windows bash) as a DSH tool, coexisting with pwsh and preferred by prompt guidance; ships a bundled troubleshooting skill registered with the skill registry.",
  "license": "MIT",
  "author": "dsh-niubash-windows contributors",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skill"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "niubash",
    "bash",
    "windows",
    "shell",
    "skill"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwased/dsh-niubash-windows.git"
  },
  "homepage": "https://github.com/qwased/dsh-niubash-windows#readme",
  "bugs": {
    "url": "https://github.com/qwased/dsh-niubash-windows/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.1.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}