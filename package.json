{
  "name": "dsh-niubash-windows",
  "version": "0.1.0",
  "description": "Niubash (native Windows bash) as a DSH tool, coexisting with pwsh and preferred by prompt guidance.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "niubash",
    "bash",
    "windows",
    "shell"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.0-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.1.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}